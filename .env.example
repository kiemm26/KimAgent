# ============================================================
# KIM-AGENT — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# --- NODE ---
NODE_ENV=development
LOG_LEVEL=info

# --- SERVER ---
PORT=4000
WEBHOOK_SECRET=your_webhook_secret_here

# --- WAHA GATEWAY ---
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION=default
WAHA_WEBHOOK_URL=http://host.docker.internal:4000/api/webhook

# --- WHATSAPP OWNER ---
# Your WhatsApp number (with country code, no +) — kimAgent responds
OWNER_JID=628XXXXXXXXXX@s.whatsapp.net

# --- GEMINI API KEYS (comma-separated for pool rotation) ---
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# --- GEMINI MODELS (comma-separated for multi-model fallback) ---
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# --- OPENROUTER FALLBACK ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5

# --- PYTHON RUNNER ---
PYTHON_RUNNER_URL=http://localhost:8000
PYTHON_RUNNER_SECRET=kim_secret_runner_key
PYTHON_EXEC_TIMEOUT_MS=10000

# --- SQLITE ---
DB_PATH=./data/db/kim.db

# --- DEBOUNCER ---
DEBOUNCE_WINDOW_MS=1000
DEBOUNCE_MAX_MESSAGES=10

# --- REACT ENGINE ---
REACT_MAX_STEPS=8
REACT_CONTEXT_WINDOW_TOKENS=30000

# --- CRYSTALLIZATION ---
CRYSTALLIZE_MIN_STEPS=2
CRYSTALLIZE_ENABLED=true

# --- SCHEDULER (cron syntax) ---
REMINDER_CHECK_CRON=* * * * *
WAL_CHECKPOINT_CRON=0 */6 * * *
DB_BACKUP_CRON=0 2 * * *
