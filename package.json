{
  "name": "kim-agent",
  "version": "1.0.0",
  "description": "Autonomous AI Executive Assistant for WhatsApp — Powered by Gemini + ReAct Engine",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bundle.mjs && cp src/db/schema.sql dist/schema.sql",
    "start": "node dist/bundle.mjs",
    "dev": "npm run build && node dist/bundle.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "pm2:start": "pm2 start pm2.config.cjs",
    "pm2:stop": "pm2 stop kim-agent",
    "pm2:logs": "pm2 logs kim-agent"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
